# /etc/qtmesh-runner.env — environment for the systemd unit. chmod 600!
QTMESH_API_URL=https://api.qtmesh.dev
QTMESH_RUNNER_TOKEN=qtm_run_replace_me
QTMESH_RUNNER_NAME=my-linux-pc
# Docker executor is the default. For a native binary instead:
#QTMESH_NATIVE_QTMESH=/usr/local/bin/qtmesh
#QTMESH_DOCKER_IMAGE=ghcr.io/fernandotonon/qtmesh:latest
#QTMESH_POLL_INTERVAL=30
#QTMESH_WORK_DIR=/var/tmp/qtmesh-runner

# Persistent cache for the ONNX model weights used by the ML backends
# (UniRig auto-rig ~1.4 GB, SkinTokens ~2.3 GB). Containers run with --rm and
# --network=none, so without a persistent cache these models cannot be fetched
# and `--algo unirig` silently degrades to the deterministic template rig.
# Seed it once (online) with:
#   node agent.mjs warm-models             # unirig (~1.4 GB) + skintokens (~2.3 GB)
# Defaults to ~/.qtmesh-runner/ai-models. Set empty to disable the mount.
#QTMESH_MODEL_CACHE_DIR=/var/lib/qtmesh-runner/ai-models

# Memory cap for the processor container. Defaults to ~2/3 of the Docker VM's
# memory (clamped to 4-12g). The ML backends load multi-GB ONNX graphs, so too
# low a cap gets them OOM-killed (exit 137, no output) mid-job.
#QTMESH_JOB_MEMORY=8g
